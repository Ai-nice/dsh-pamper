{
  "name": "dsh-pamper",
  "version": "0.3.2",
  "type": "module",
  "description": "宠爱页面套件：自动给 dsh-pet 打补丁，提供角色/桌宠配置/发现页与动作按需下载。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "catalog/action-store.json",
    "patcher/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "Ai-nice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ai-nice/dsh-pamper.git",
    "directory": "plugins/dsh-pamper"
  },
  "homepage": "https://github.com/Ai-nice/dsh-pamper",
  "bugs": {
    "url": "https://github.com/Ai-nice/dsh-pamper/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "actions",
    "dsh-pet"
  ]
}
