{
  "name": "dsh-pamper",
  "version": "0.2.1",
  "type": "module",
  "description": "独立桌宠插件：宠爱页面 + 页面内宠物显示，动作按需从 CDN 下载（不依赖 dsh-pet）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "catalog/action-store.json",
    "cleanup/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "author": "Ai-nice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ai-nice/dsh-pamper.git",
    "directory": "plugins/dsh-pamper"
  },
  "homepage": "https://github.com/Ai-nice/dsh-pamper",
  "bugs": {
    "url": "https://github.com/Ai-nice/dsh-pamper/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "actions",
    "dsh-pet"
  ]
}
