{
  "name": "dsh-pamper",
  "version": "0.4.3",
  "type": "module",
  "description": "完全独立的 pamper 宠爱插件：自有宠爱页面（角色/桌宠配置/发现）、页面内宠物浮层、动作按需下载；不依赖 dsh-pet。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "catalog/action-store.json",
    "helper/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "Ai-nice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ai-nice/dsh-pamper.git",
    "directory": "plugins/dsh-pamper"
  },
  "homepage": "https://github.com/Ai-nice/dsh-pamper",
  "bugs": {
    "url": "https://github.com/Ai-nice/dsh-pamper/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "actions",
    "dsh-pet"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
